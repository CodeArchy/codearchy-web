# ── Application ──────────────────────────────────────────────────────────────
# Host port for the web server (default: 3000)
APP_PORT=3000

# Production domain (used in deploy.sh summary)
DOMAIN=codearchy.com

# ── Git ───────────────────────────────────────────────────────────────────────
GIT_REMOTE=origin
GIT_BRANCH=main

# ── Dokploy — Webhook mode ────────────────────────────────────────────────────
# Set this if you use Dokploy's git-provider webhook to trigger redeploys.
# DOKPLOY_WEBHOOK_URL=https://dokploy.yourdomain.com/api/deploy/...

# ── Dokploy — API mode ────────────────────────────────────────────────────────
# DOKPLOY_URL=https://dokploy.yourdomain.com
# DOKPLOY_API_KEY=your-api-key-here
# DOKPLOY_APPLICATION_ID=your-application-id-here

# ── VPS — SSH mode ────────────────────────────────────────────────────────────
# VPS_HOST=1.2.3.4
# VPS_USER=root
# VPS_SSH_KEY=~/.ssh/id_rsa
# VPS_APP_DIR=/etc/dokploy/compose/codearchy-web

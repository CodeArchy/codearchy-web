{
    "name": "@codearchy/app",
    "version": "0.1.0",
    "private": true,
    "description": "The CodeArchy web app (app.codearchy.com): your codebase's architecture, computed in your browser.",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "assets": "node scripts/assets.mjs",
        "dev": "node scripts/assets.mjs && vite",
        "build": "node scripts/assets.mjs && tsc -p tsconfig.json --noEmit && vite build",
        "preview": "vite preview",
        "voice": "node scripts/voice-model.mjs",
        "test:e2e": "node test/smoke.mjs"
    },
    "dependencies": {
        "@codearchy/ai": "workspace:*",
        "@codearchy/platform-browser": "workspace:*",
        "@codearchy/protocol": "workspace:*",
        "@codearchy/providers": "workspace:*",
        "@codearchy/ui": "workspace:*",
        "@codemirror/lang-go": "6.0.1",
        "@codemirror/lang-java": "6.0.2",
        "@codemirror/lang-javascript": "6.2.5",
        "@codemirror/lang-php": "6.0.2",
        "@codemirror/lang-python": "6.2.1",
        "@codemirror/lang-rust": "6.0.2",
        "@codemirror/language": "6.13.1",
        "@codemirror/legacy-modes": "6.5.5",
        "@codemirror/state": "6.7.6",
        "@codemirror/theme-one-dark": "6.1.3",
        "@codemirror/view": "6.43.15",
        "kokoro-js": "1.2.1",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "workbox-window": "7.4.1"
    },
    "devDependencies": {
        "@codearchy/cli": "workspace:*",
        "@codearchy/conformance": "workspace:*",
        "@codearchy/grammars": "workspace:*",
        "@codearchy/treesitter": "workspace:*",
        "@sqlite.org/sqlite-wasm": "3.54.1-build1",
        "@types/react": "18.3.31",
        "@types/react-dom": "18.3.7",
        "@vitejs/plugin-react": "6.2.1",
        "elkjs": "0.11.1",
        "fflate": "0.8.3",
        "playwright": "1.65.0",
        "typescript": "5.9.3",
        "vite": "8.3.6",
        "vite-plugin-pwa": "2.0.0"
    }
